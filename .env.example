SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
# Optional override if a global DEBUG variable interferes (also set False in production):
NUMLEARN_DEBUG=True
# Official database (create the database and role first):
DATABASE_URL=postgres://numlearn:change-me@localhost:5432/numlearn
# For local use without PostgreSQL, empty DATABASE_URL and enable this explicitly.
ALLOW_SQLITE=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
# Correo para recuperar contraseña. Por defecto se imprime en consola (desarrollo).
# Producción, por ejemplo: EMAIL_URL=smtp+tls://usuario:clave@smtp.proveedor.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=NumLearn <no-responder@tu-dominio.com>
# POST por minuto, operación e IP de conexión (REMOTE_ADDR); 0 desactiva.
# Detrás de un proxy, configura allí el límite por cliente. No se confía en X-Forwarded-For.
NUMLEARN_API_RATE_LIMIT=120
