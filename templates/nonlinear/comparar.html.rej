-<section class="panel"><form id="compare-form"><div class="compare-inputs"><div><label for="expression">Función f(x)</label><input name="expression" id="expression" value="x^3 - x - 2" maxlength="200" required></div><div data-compare-param="g"><label for="g">Transformación g(x), equivalente a f(x)=0</label><input id="g" name="g" value="(x + 2)^(1/3)" maxlength="200"><small>Usa (x + 2)^0.3333333333333333 para este ejemplo. Verificamos también el residuo de f.</small></div><div data-compare-param="a"><label for="a">a</label><input id="a" name="a" type="number" step="any" value="1"></div><div data-compare-param="b"><label for="b">b</label><input id="b" name="b" type="number" step="any" value="2"></div><div data-compare-param="x0"><label for="x0">x₀</label><input id="x0" name="x0" type="number" step="any" value="1.5"></div><div data-compare-param="x1"><label for="x1">x₁</label><input id="x1" name="x1" type="number" step="any" value="2"></div><div><label for="tolerance">Tolerancia</label><input id="tolerance" name="tolerance" type="number" step="any" value="0.0001" min="1e-12" max="0.1" required></div><div><label for="max_iterations">Máximo iteraciones</label><input id="max_iterations" name="max_iterations" type="number" value="100" min="1" max="200" required></div></div><fieldset class="method-choices"><legend>Métodos a comparar</legend>{% for key,m in methods.items %}<label><input type="checkbox" name="methods" value="{{ key }}" {% if key == 'bisection' or key == 'newton' or key == 'secant' %}checked{% endif %}> {{ m.title }}</label>{% endfor %}</fieldset><button class="btn btn-primary" type="submit">Comparar recorridos <i class="bi bi-arrow-right"></i></button></form></section>
+<section class="panel"><form id="compare-form"><div class="compare-inputs"><div><label for="expression">Función f(x)</label><input name="expression" id="expression" value="x^3 - x - 2" maxlength="200" required></div><div data-compare-param="g"><label for="g">Transformación g(x), equivalente a f(x)=0</label><input id="g" name="g" value="(x + 2)^(1/3)" maxlength="200"><small>Usa (x + 2)^0.3333333333333333 para este ejemplo. Verificamos también el residuo de f.</small></div><div data-compare-param="a"><label for="a">a</label><input id="a" name="a" type="number" step="any" value="1"></div><div data-compare-param="b"><label for="b">b</label><input id="b" name="b" type="number" step="any" value="2"></div><div data-compare-param="x0"><label for="x0">x₀</label><input id="x0" name="x0" type="number" step="any" value="1.5"></div><div data-compare-param="x1"><label for="x1">x₁</label><input id="x1" name="x1" type="number" step="any" value="2"></div><div><label for="tolerance">Tolerancia</label><input id="tolerance" name="tolerance" type="number" step="any" value="0.000001" min="1e-12" max="0.1" required></div><div><label for="max_iterations">Máximo iteraciones</label><input id="max_iterations" name="max_iterations" type="number" value="100" min="1" max="200" required></div></div><fieldset class="method-choices"><legend>Métodos a comparar</legend>{% for key,m in methods.items %}<label><input type="checkbox" name="methods" value="{{ key }}" {% if key == 'bisection' or key == 'newton' or key == 'secant' %}checked{% endif %}> {{ m.title }}</label>{% endfor %}</fieldset><button class="btn btn-primary" type="submit">Comparar recorridos <i class="bi bi-arrow-right"></i></button></form></section>
